{
  "name": "gwent-learning-project",
  "license": "SEE LICENSE IN LICENSE",
  "repository": "https://github.com/HungVPham/gwent-learning-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "benchmark:smoke": "tsx scripts/run-benchmark-report.ts --suite benchmark-smoke-v1",
    "benchmark:starter-matrix": "tsx scripts/run-benchmark-report.ts --suite benchmark-starter-matrix-v1",
    "benchmark:v1-smoke": "tsx scripts/run-benchmark-report.ts --suite benchmark-v1-smoke-v1",
    "benchmark:v1-starter-matrix": "tsx scripts/run-benchmark-report.ts --suite benchmark-v1-starter-matrix-v1",
    "benchmark:v1-failure-mining": "tsx scripts/run-benchmark-failure-mining-report.ts --suite benchmark-v1-starter-matrix-v1",
    "benchmark:v1-starter-matrix-expanded": "tsx scripts/run-benchmark-report.ts --suite benchmark-v1-starter-matrix-expanded-v1",
    "benchmark:v1-failure-mining-expanded": "tsx scripts/run-benchmark-failure-mining-report.ts --suite benchmark-v1-starter-matrix-expanded-v1",
    "benchmark:long": "node scripts/run-long-benchmark.mjs",
    "check:forbidden-imports": "node scripts/check-forbidden-imports.mjs",
    "check:project-state": "node scripts/check-project-state-update.mjs",
    "check:worktree-clean": "node scripts/check-worktree-clean.mjs",
    "ci": "npm run lint && npm test && npm run build && npm run check:forbidden-imports && npm run check:project-state && npm run check:worktree-clean",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "ci:browser": "npm run build && npm run test:e2e",
    "preview": "vite preview",
    "start": "vite preview --host --port $PORT"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.8.2",
    "@types/react-router-dom": "^5.3.3",
    "@types/styled-components": "^5.1.34",
    "framer-motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.1.1",
    "styled-components": "^6.1.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "path": "^0.12.7",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.5"
  }
}
